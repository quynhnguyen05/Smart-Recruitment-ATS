generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  RECRUITER
  INTERVIEWER
  HIRING_MANAGER
  CANDIDATE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  NEW
  SCORED
  SCREENING_PASSED
  REJECTED
  INTERVIEWING
  OFFERED
}

enum MatchResultStatus {
  OK
  INSUFFICIENT_DATA
  ERROR
}

enum InterviewRoundStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InterviewQuestionStatus {
  ACCEPTED
  REJECTED
  EDITED
}

enum OfferStatus {
  DRAFT
  CONFIRMED
  ACCEPTED_BY_CANDIDATE
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model JobPosting {
  id           String    @id @default(uuid())
  title        String
  description  String
  requirements String
  status       JobStatus @default(DRAFT)
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  applications Application[]

  @@map("job_postings")
}

model Application {
  id                  String             @id @default(uuid())
  jobId               String             @map("job_id")
  job                 JobPosting         @relation(fields: [jobId], references: [id])
  candidateId         String             @map("candidate_id")
  cvUrl               String             @map("cv_url")
  cvText              String?            @map("cv_text")
  status              ApplicationStatus  @default(NEW)
  latestMatchResultId String?            @map("latest_match_result_id")
  appliedAt           DateTime           @default(now()) @map("applied_at")

  matchResults    MatchResult[]
  interviewRounds InterviewRound[]
  offer           Offer?

  @@unique([jobId, candidateId], name: "one_application_per_job_per_candidate")
  @@map("applications")
}

model MatchResult {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  matchScore    Int?
  matchedSkills Json?
  missingSkills Json?
  confidence    String?
  status        String      // OK | INSUFFICIENT_DATA | ERROR
  createdAt     DateTime    @default(now())
}

model InterviewRound {
  id            String                @id @default(uuid())
  applicationId String                @map("application_id")
  application   Application           @relation(fields: [applicationId], references: [id])
  interviewerId String                @map("interviewer_id")
  scheduledAt   DateTime              @map("scheduled_at")
  status        InterviewRoundStatus  @default(SCHEDULED)

  questions InterviewQuestion[]
  scorecard Scorecard?

  @@map("interview_rounds")
}

model InterviewQuestion {
  id            String                    @id @default(uuid())
  interviewId   String                    @map("interview_id")
  interview     InterviewRound            @relation(fields: [interviewId], references: [id])
  questionText  String                    @map("question_text")
  isAiGenerated Boolean                   @default(false) @map("is_ai_generated")
  status        InterviewQuestionStatus

  @@map("interview_questions")
}

model Scorecard {
  id            String         @id @default(uuid())
  interviewId   String         @unique @map("interview_id")
  interview     InterviewRound @relation(fields: [interviewId], references: [id])
  interviewerId String         @map("interviewer_id")
  score         Int
  notes         String?
  submittedAt   DateTime       @default(now()) @map("submitted_at")

  @@map("scorecards")
}

model Offer {
  id             String      @id @default(uuid())
  applicationId  String      @unique @map("application_id")
  application    Application @relation(fields: [applicationId], references: [id])
  salary         Decimal
  status         OfferStatus @default(DRAFT)
  confirmedByHm  String?     @map("confirmed_by_hm")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("offers")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}